# Disable react-native-firebase's Swift Package Manager resolution.
# Firebase's SPM packages only ship DYNAMIC frameworks, which conflicts
# with GoogleUserMessagingPlatform (pulled in by react-native-google-mobile-ads),
# which only ships a STATIC xcframework. Disabling SPM makes Firebase resolve
# through classic CocoaPods instead, which supports static linkage fine —
# so the whole project can stay on the default static linkage with no
# use_frameworks! needed at all.
$RNFirebaseDisableSPM = true

# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

# Firebase's Swift pods (FirebaseCoreInternal, FirebaseRemoteConfig, etc.)
# depend on GoogleUtilities / FirebaseABTesting, which don't define Swift
# modules by default. When building as static libraries, CocoaPods needs
# modular headers to import them from Swift — this generates those module
# maps for every pod.
use_modular_headers!

target 'DailyPlannerApp' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
  end
end
